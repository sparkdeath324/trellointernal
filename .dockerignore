# Build context hygiene — everything here is either rebuilt in the image,
# host-specific, or must never reach a deployed container.

node_modules
.next
out
build

# The local SQLite database. Production uses a mounted volume; copying a dev
# database into the image would ship stale deals and shadow that volume.
data

