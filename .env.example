# --- Production (Vercel + Turso) --------------------------------------------
# Set both in the Vercel dashboard. When TURSO_DATABASE_URL is present the app
# talks to Turso over the network and ignores the file settings below.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=your-token

# --- Local development and self-hosted containers ---------------------------
# With no TURSO_DATABASE_URL the app opens a plain SQLite file instead.
# Defaults to <project>/data/crm.db; the container image points it at the
# mounted volume.
CRM_DB_PATH=/app/data/crm.db

# Port and bind address for the production server (container only).
PORT=3000
HOSTNAME=0.0.0.0
